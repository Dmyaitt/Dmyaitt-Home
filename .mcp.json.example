{
  "mcpServers": {
    "n8n-mcp": {
      "command": "n8n-mcp",
      "args": [],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://your-instance.app.n8n.cloud",
        "N8N_API_KEY": "YOUR_API_KEY_HERE"
      }
    }
  }
}
